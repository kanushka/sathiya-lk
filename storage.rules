rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin(sid) {
      return request.auth != null
        && request.auth.token.get('schools', {}).get(sid, {}).get('r', null) == 'a';
    }

    match /schools/{sid}/{file} {
      allow read: if file.matches('logo[.][^/]+');
      // SVG is scriptable when opened directly, so new uploads are raster only; existing SVG logos stay readable.
      allow create, update: if file.matches('logo[.](png|jpg|webp)') && isAdmin(sid)
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if file.matches('logo[.][^/]+') && isAdmin(sid);
    }
  }
}
