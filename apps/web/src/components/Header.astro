import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { appLinks, content, pagePath, sectionHref, type Lang, type Page } from '../lib/links';

interface Props {
  lang: Lang;
  page: Page;
}
const { lang, page } = Astro.props;
const t = content(lang);
const app = appLinks();
---
<header class="site-header">
  <div class="wrap header-inner">
    <Logo href={pagePath(lang, 'index')} />
    <LangSwitch lang={lang} page={page} class="mobile-only" />
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <span>{t.nav.menu}</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label={t.nav.label}>
      <a class="nav-link" href={sectionHref(lang, page, 'features')}>{t.nav.features}</a>
      <a class="nav-link" href={sectionHref(lang, page, 'how')}>{t.nav.how}</a>
      <a class="nav-link" href={sectionHref(lang, page, 'faq')}>{t.nav.faq}</a>
      <LangSwitch lang={lang} page={page} class="desktop-only" />
      <a class="nav-login" href={app.login}>{t.nav.login}</a>
      <a class="btn btn-primary btn-sm" href={app.register}>{t.nav.register}</a>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var toggle = header && header.querySelector('.menu-toggle');
    if (!toggle) return;
    function set(open) {
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    }
    toggle.addEventListener('click', function () {
      set(!header.classList.contains('menu-open'));
    });
    header.querySelector('.site-nav').addEventListener('click', function (e) {
      if (e.target.closest('a')) set(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) {
        set(false);
        toggle.focus();
      }
    });
  })();
</script>
