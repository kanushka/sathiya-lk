---
import { content, type Lang } from '../lib/links';

interface Props {
  lang: Lang;
}
const t = content(Astro.props.lang);
---
<article class="wrap prose">
  <h1>{t.contact.title}</h1>
  {t.contact.body.map((p) => <p>{p}</p>)}
  <p class="contact-email" lang="en">{t.contact.email}</p>
  <p class="note">{t.contact.teacherNote}</p>
</article>
