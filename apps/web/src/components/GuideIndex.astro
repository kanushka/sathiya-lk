import { content, pagePath, type Lang } from '../lib/links';
import { guides } from '../content/guides';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content(lang).guide;
---
<article class="wrap prose guide">
  <h1>{t.title}</h1>
  <p class="guide-summary">{t.intro}</p>
  <ol class="guide-list">
    {guides.map((g) => (
      <li>
        <a href={pagePath(lang, `guide/${g.slug}`)}>{g.text[lang].title}</a>
        <p>{g.text[lang].summary}</p>
        <p class="guide-meta">
          {t.listMinutes.replace('{n}', String(g.minutes))}
          {g.youtube[lang] && <span> · {t.hasVideo}</span>}
        </p>
      </li>
    ))}
  </ol>
</article>
