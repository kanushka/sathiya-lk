---
import { content, pagePath, type Lang } from '../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content(lang);
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <span>{t.footer.copyright}</span>
    <nav class="footer-links" aria-label={t.footer.label}>
      <a href={pagePath(lang, 'terms')}>{t.footer.terms}</a>
      <a href={pagePath(lang, 'privacy')}>{t.footer.privacy}</a>
      <a href={pagePath(lang, 'contact')}>{t.footer.contact}</a>
      <button type="button" class="link-button" data-consent-open>{t.footer.analytics}</button>
    </nav>
  </div>
</footer>
