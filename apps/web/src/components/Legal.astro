---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Kanushka Gayan
import { LEGAL_VERSION, appLinks, content, type Lang } from '../lib/links';

interface Props {
  lang: Lang;
  doc: 'terms' | 'privacy';
}
const { lang, doc } = Astro.props;
const t = content(lang);
const d = t[doc];
---
<article class="wrap prose">
  <h1>{d.title}</h1>
  <p class="meta-line">{t.legal.version} <time datetime={LEGAL_VERSION}>{LEGAL_VERSION}</time></p>
  <p class="draft" role="note">{t.legal.draft}</p>
  {d.sections.map((s) => (
    <section>
      <h2>{s.title}</h2>
      {s.body.map((p) => <p>{p}</p>)}
      {'report' in s && s.report && <p><a href={appLinks().report}>{t.footer.report}</a></p>}
    </section>
  ))}
</article>
