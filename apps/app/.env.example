# Copy to .env.local (git-ignored). Never commit real values.

# reCAPTCHA Enterprise site key for App Check. Unset = App Check off.
VITE_APPCHECK_SITE_KEY=

# Emulator mode only: a debug token registered in the Firebase console. Unset = App Check off in emulator mode.
VITE_APPCHECK_DEBUG_TOKEN=

# Set to "true" to connect Auth/Firestore/Functions/Storage to the local emulators.
VITE_USE_EMULATORS=

# Cloud Functions region (empty = SDK default).
VITE_FUNCTIONS_REGION=

# Marketing site base URL for terms/privacy links (default https://sathiya.kanushka.com).
VITE_WEB_URL=
