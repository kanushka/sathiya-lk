# Local overrides go in .env.local (git-ignored; loaded in every mode, production builds included). Staging-only values (debug token) go in .env.staging.local. Never commit secrets.

# reCAPTCHA Enterprise (Fraud Defense) site key for App Check. Unset = App Check off.
VITE_APPCHECK_SITE_KEY=

# Debug token registered in the Firebase console. Used in emulator mode, or in a non-emulator build only with VITE_APPCHECK_ALLOW_DEBUG=true. Put it in .env.staging.local, never in a production build.
VITE_APPCHECK_DEBUG_TOKEN=

# "true" lets a non-emulator build use VITE_APPCHECK_DEBUG_TOKEN (staging only; production-mode builds ignore it).
VITE_APPCHECK_ALLOW_DEBUG=

# "staging" selects the staging Firebase project config (see @sathiya/firebase-config). Empty = production.
VITE_FIREBASE_ENV=

# Set to "true" to connect Auth/Firestore/Functions/Storage to the local emulators.
VITE_USE_EMULATORS=

# Cloud Functions region (empty = SDK default).
VITE_FUNCTIONS_REGION=

# Marketing site base URL for terms/privacy links (default https://sathiya.kanushka.com).
VITE_WEB_URL=
