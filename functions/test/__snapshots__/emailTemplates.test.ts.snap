exports[`email templates > adminInvite snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>You&#39;re invited to manage Siripura Central College on Sathiya</title></head>
<body style="margin:0;padding:0;background:#E9E8E3">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#FBFAF7"><tr><td align="center" style="padding:28px 12px">
<table role="presentation" width="520" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:520px;background:#FFFFFF;border:1px solid #ECEDF1;border-radius:12px;overflow:hidden">
<tr><td style="background:#7A1F3D;color:#FFFFFF;padding:18px 24px;font-family:Inter,'Segoe UI',Helvetica,Arial,'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',sans-serif;font-weight:800;font-size:18px">Siripura Central College</td></tr>
<tr><td style="padding:24px;color:#14213D">
<div style="font-family:Inter,'Segoe UI',Helvetica,Arial,'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',sans-serif;font-size:15px;line-height:1.6"><p style="margin:0 0 12px;">Hello,</p><p style="margin:0 0 12px;"><b>W. Perera</b> invited you to be an admin of <b>Siripura Central College</b> on Sathiya, where the school builds its timetables.</p><table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:8px 0 4px"><tr><td style="background:#0E6B6A;border-radius:10px"><a href="https://app.example.test/login" style="display:inline-block;padding:12px 22px;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:15px">Accept invite</a></td></tr></table><p style="margin:12px 0 0;font-size:13px;color:#5A6378">Sign in with this email address (Google or password). The invite is waiting for you.</p></div>
<div style="border-top:1px solid #ECEDF1;margin-top:20px;padding-top:16px;color:#3B4560"><div style="font-family:'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',Inter,Arial,sans-serif;font-size:14px;line-height:1.6"><p style="margin:0 0 12px;">ආයුබෝවන්,</p><p style="margin:0 0 12px;">සිරිපුර මධ්‍ය මහා විද්‍යාලය පාසලේ Sathiya පරිපාලකයෙකු ලෙස එක්වීමට W. Perera ඔබට ආරාධනා කර ඇත. ඉහත බොත්තම ඔබන්න.</p></div></div>
</td></tr>
</table>
<p style="margin:0;padding:16px 24px 0;text-align:center;font-family:Inter,'Segoe UI',Helvetica,Arial,'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',sans-serif;font-size:12px;line-height:1.6;color:#8A91A3">Sent by Sathiya for Siripura Central College. Not expecting this? Ignore it.</p>
</td></tr></table>
</body></html>",
  "subject": "You're invited to manage Siripura Central College on Sathiya",
  "text": "Hello,

W. Perera invited you to be an admin of Siripura Central College on Sathiya, where the school builds its timetables.

Accept invite: https://app.example.test/login

Sign in with this email address (Google or password). The invite is waiting for you.

---

ආයුබෝවන්,

සිරිපුර මධ්‍ය මහා විද්‍යාලය පාසලේ Sathiya පරිපාලකයෙකු ලෙස එක්වීමට W. Perera ඔබට ආරාධනා කර ඇත. ඉහත බොත්තම ඔබන්න.

--
Sent by Sathiya for Siripura Central College. Not expecting this? Ignore it.",
}
`;

exports[`email templates > passwordReset snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ඔබගේ මුරපදය යළි සකසන්න · Reset your Sathiya password</title></head>
