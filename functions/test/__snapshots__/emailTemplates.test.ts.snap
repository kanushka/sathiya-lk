exports[`email templates > adminInvite snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Join Siripura Central College on Sathiya (සතිය)</title></head>
