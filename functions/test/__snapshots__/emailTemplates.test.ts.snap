exports[`email templates > schoolRegistered snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Welcome to Sathiya: Siripura Central College is registered</title></head>
<body style="margin:0;padding:0;background:#E9E8E3">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#FBFAF7"><tr><td align="center" style="padding:28px 12px">
<table role="presentation" width="520" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:520px;background:#FFFFFF;border:1px solid #ECEDF1;border-radius:12px;overflow:hidden">
<tr><td style="background:#7A1F3D;color:#FFFFFF;padding:18px 24px;font-family:Inter,'Segoe UI',Helvetica,Arial,'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',sans-serif;font-weight:800;font-size:18px">Siripura Central College</td></tr>
<tr><td style="padding:24px;color:#14213D">
<div style="font-family:Inter,'Segoe UI',Helvetica,Arial,'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',sans-serif;font-size:15px;line-height:1.6"><p style="margin:0 0 12px;">Hello W. Perera,</p><p style="margin:0 0 12px;"><b>Siripura Central College</b> is now registered on Sathiya. Here is how to get started:</p><ol style="margin:0 0 12px;padding-left:20px"><li style="margin:0 0 6px">Add your subjects, period times and classes.</li><li style="margin:0 0 6px">Add your teachers. Each one gets a login slip.</li><li style="margin:0 0 6px">Build the timetable, then publish it.</li></ol><table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:8px 0 4px"><tr><td style="background:#0E6B6A;border-radius:10px"><a href="https://app.example.test/login" style="display:inline-block;padding:12px 22px;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:15px">Open Sathiya</a></td></tr></table><p style="margin:12px 0 0;font-size:13px;color:#5A6378">Invite other admins from the school settings when you are ready.</p></div>
<div style="border-top:1px solid #ECEDF1;margin-top:20px;padding-top:16px;color:#3B4560"><div style="font-family:'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',Inter,Arial,sans-serif;font-size:14px;line-height:1.6"><p style="margin:0 0 12px;">ආයුබෝවන් W. Perera,</p><p style="margin:0 0 12px;">සිරිපුර මධ්‍ය මහා විද්‍යාලය Sathiya හි ලියාපදිංචි කර ඇත. ආරම්භ කිරීමට:</p><ol style="margin:0 0 12px;padding-left:20px"><li style="margin:0 0 6px">විෂයන්, කාලච්ඡේද වේලාවන් සහ පන්ති එක් කරන්න.</li><li style="margin:0 0 6px">ගුරුවරුන් එක් කරන්න. සෑම ගුරුවරයෙකුටම පිවිසුම් පත්‍රිකාවක් ලැබේ.</li><li style="margin:0 0 6px">කාලසටහන සාදා එය ප්‍රකාශයට පත් කරන්න.</li></ol></div></div>
</td></tr>
</table>
<p style="margin:0;padding:16px 24px 0;text-align:center;font-family:Inter,'Segoe UI',Helvetica,Arial,'Noto Sans Sinhala','Iskoola Pota','Nirmala UI',sans-serif;font-size:12px;line-height:1.6;color:#8A91A3">Sathiya: free school timetables for Sri Lanka · <a href="https://www.example.test/" style="color:#8A91A3">www.example.test</a></p>
</td></tr></table>
</body></html>",
  "subject": "Welcome to Sathiya: Siripura Central College is registered",
  "text": "Hello W. Perera,

Siripura Central College is now registered on Sathiya. Here is how to get started:

1. Add your subjects, period times and classes.
2. Add your teachers. Each one gets a login slip.
3. Build the timetable, then publish it.

Open Sathiya: https://app.example.test/login

Invite other admins from the school settings when you are ready.

---

ආයුබෝවන් W. Perera,

සිරිපුර මධ්‍ය මහා විද්‍යාලය Sathiya හි ලියාපදිංචි කර ඇත. ආරම්භ කිරීමට:

1. විෂයන්, කාලච්ඡේද වේලාවන් සහ පන්ති එක් කරන්න.
2. ගුරුවරුන් එක් කරන්න. සෑම ගුරුවරයෙකුටම පිවිසුම් පත්‍රිකාවක් ලැබේ.
3. කාලසටහන සාදා එය ප්‍රකාශයට පත් කරන්න.

--
Sathiya: free school timetables for Sri Lanka
https://www.example.test/",
