{
  "name": "functions",
  "private": true,
  "version": "0.0.0",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "grant-super": "esbuild scripts/grantSuper.ts --bundle --platform=node --format=cjs --external:firebase-admin --log-level=warning --outfile=scripts/dist/grantSuper.cjs && node scripts/dist/grantSuper.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.0",
    "firebase": "^10.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
