{
  "name": "functions",
  "private": true,
  "version": "0.0.0",
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "grant-super": "esbuild scripts/grantSuper.ts --bundle --platform=node --format=cjs --external:firebase-admin --log-level=warning --outfile=lib/grantSuper.cjs && node lib/grantSuper.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.0",
    "firebase": "^10.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
